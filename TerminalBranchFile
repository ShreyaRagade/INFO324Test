    public bool canNavigate = false;



    private void Start()
    {
        foreach (var text in menuText)
        {
            text.color = Color.grey;
        }

        foreach (var page in pages)
        {
            page.SetActive(false);
        }

       // menuText[0].color = Color.magenta;
        
    }

    void Update()
    {
        //Debug.Log(canNavigate);
        if (canNavigate)
        {
            NavigatePages();
        }

        if (!canNavigate)
        {
            foreach (var text in menuText)
            {
                text.color = Color.grey;
            }
        }

        //if (EventSystem.current.currentSelectedGameObject == null)
        //    Debug.Log("NO SELECTED OBJECT");
        //else
        //    Debug.Log("Selected: " + EventSystem.current.currentSelectedGameObject);



    }

    public void OnArrow()
    {
        Debug.Log("in on arrow");
        foreach (var text in menuText)
        {
            text.color = Color.grey;
        }
        canNavigate = false;
        
    }
    
    public void EnterTopMenu() //Press Submit on Arrow
    {
        Debug.Log("Entering");
        
        //Eventually play some kind of animation here instead of highlight
        foreach (var panel in pausePanels)
        {
            panel.SetActive(false);
        }

        foreach (var text in menuText)
        {
            text.color = Color.white;
        }

        EventSystem.current.SetSelectedGameObject(buttons[0]);
        pages[0].SetActive(true);
        canNavigate = true;

    }

    public void ExitTopMenu() //Press Cancel on Item, Equip, Map or Options
    {
        EventSystem.current.SetSelectedGameObject(arrow);

        foreach (var panel in pausePanels)
        {
            panel.SetActive(true);
        }

        foreach (var page in pages)
        {
            page.SetActive(false);
        }

        foreach (var text in menuText)
        {
            text.color = Color.grey;
        }

        canNavigate = false;
    }

    public void CloseEverything() //Press Cancel on Arrow
    {
        menu.SetActive(false);
        PauseController.SetPause(false);


    }

    public void NavigatePages() //Grey out page text
    {
        for (int i = 0; i < pages.Length; i++)
        {

            if (EventSystem.current.currentSelectedGameObject == buttons[i])
            {

                menuText[i].color = Color.magenta;
                pages[i].SetActive(true);

                //Set everything in those pages to grey

                if (buttons[0]) //if this sets everything turn it back to white otherwise
                {
                    foreach (Transform slotTransform in UseInventoryController.Instance.inventoryPanel.transform)
                    {

                        Slot slot = slotTransform.GetComponent<Slot>();

                        if (slot.currentItem != null)
                        {
                            Transform theSlotTransform = slot.transform;

                            TMP_Text item = theSlotTransform.GetComponentInChildren<TMP_Text>();

                            //Transform itemTransform = slotTransform.GetChild(0);   //Getting the Item Transform

                            //GameObject itemGO = itemTransform.gameObject;

                            //TMP_Text item = itemGO.GetComponent<TMP_Text>(); //Reference to Item Transform


                            //if (item == null) Debug.Log("itemtextsnull");
                            item.color = Color.grey;
                        }

                    }
                }


            }

            else
            {
                menuText[i].color = Color.white;
                pages[i].SetActive(false);


            }

   }

}
  
        
    public void OpenThePage(int tabNo) //Press Z (Submit on Page). Also, Appropriately adjust EventSystem currentSelectedGameObject Grey out top color text - dulled purple or whatever
    {

        if (tabNo == 0 && UseInventoryController.Instance.itemCounterIndex == 0)
        {
            //Do Nothing
            ;
        }

        else
        {
            canNavigate = false;
            Debug.Log("Opening page");
            for (int i = 0; i < pages.Length; i++)
            {

                pages[i].SetActive(false);

            }

            pages[tabNo].SetActive(true);
            menuText[tabNo].color = Color.magenta;

            if (tabNo == 0 && UseInventoryController.Instance.itemCounterIndex != 0)
            {
                foreach (Transform slotTransform in UseInventoryController.Instance.inventoryPanel.transform)
                {
                    Slot newSlot = slotTransform.GetComponent<Slot>();

                    if (newSlot.currentItem != null)
                    {
                        
                        Transform theSlotTransform = newSlot.transform;

                        TMP_Text itemText = theSlotTransform.GetComponentInChildren<TMP_Text>();

                        itemText.color = Color.white;
                    }

                }

                Transform firstSlotTransform = UseInventoryController.Instance.inventoryPanel.transform.GetChild(0); //Reference to Slot Transform
                Slot slot = firstSlotTransform.GetComponent<Slot>(); //Getting the Slot
                                                                     // Debug.Log(slot);

                if (slot.currentItem == null)
                {
                    Debug.Log("No items in inventory");
                    return;

                }

                if (slot.currentItem != null)
                {
                    Debug.Log("Item(s) in inventory");

                }
                Transform item = firstSlotTransform.GetChild(0); //Reference to Item Transform

                GameObject itemGO = item.gameObject; //Getting the Item

                EventSystem.current.SetSelectedGameObject(itemGO);
            }

        }
       

        

    }

   

